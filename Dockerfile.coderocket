# syntax=docker/dockerfile:1

ARG NODE_VERSION=24.15.0
ARG PNPM_VERSION=10.33.0
ARG TURBO_VERSION=2.9.16

FROM node:${NODE_VERSION}-bookworm-slim AS pnpm-base

ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate

FROM pnpm-base AS pruner

ARG TURBO_VERSION
WORKDIR /app
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm add --global "turbo@${TURBO_VERSION}"
COPY . .
RUN turbo prune @coderocket/cloud @coderocket/worker --docker

FROM pnpm-base AS build

ARG NEXT_PUBLIC_SITE_URL=__CODEROCKET_SITE_URL__
ARG NEXT_PUBLIC_SUPABASE_URL=__CODEROCKET_SUPABASE_URL__
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=__CODEROCKET_SUPABASE_PUBLISHABLE_KEY__
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ARG NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=__CODEROCKET_ANALYTICS_ID__
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=$NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ENV NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=$NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
WORKDIR /app
COPY --from=pruner /app/out/json/ ./
COPY scripts/setup/install-lefthook.mjs ./scripts/setup/install-lefthook.mjs
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --filter @coderocket/cloud... --frozen-lockfile
COPY --from=pruner /app/out/full/ ./
COPY scripts/setup/prepare-coderocket-runtime-env.mjs \
  ./scripts/setup/prepare-coderocket-runtime-env.mjs
RUN pnpm --filter @coderocket/cloud build
RUN node scripts/setup/prepare-coderocket-runtime-env.mjs --index

FROM pnpm-base AS worker-dependencies

WORKDIR /app
COPY --from=pruner /app/out/json/ ./
COPY scripts/setup/install-lefthook.mjs ./scripts/setup/install-lefthook.mjs
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --filter @coderocket/worker... --prod --frozen-lockfile
COPY --from=pruner /app/out/full/ ./

FROM node:${NODE_VERSION}-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV CODEROCKET_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
RUN apt-get update \
  && apt-get install -y --no-install-recommends chromium fonts-liberation \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=worker-dependencies --chown=node:node /app /app
COPY --from=build --chown=node:node /app/apps/cloud/public ./apps/cloud/public
COPY --from=build --chown=node:node /app/apps/cloud/.next/standalone \
  ./apps/cloud/.next/standalone
COPY --from=build --chown=node:node /app/apps/cloud/.next/static ./apps/cloud/.next/static
COPY --from=build --chown=node:node /app/apps/cloud/.next/coderocket-runtime-env-files.json \
  ./apps/cloud/.next/coderocket-runtime-env-files.json
COPY --from=build --chown=node:node /app/scripts/setup/prepare-coderocket-runtime-env.mjs \
  ./scripts/setup/prepare-coderocket-runtime-env.mjs
USER node
EXPOSE 3000
CMD ["sh", "-lc", "node scripts/setup/prepare-coderocket-runtime-env.mjs && exec node apps/cloud/.next/standalone/apps/cloud/server.js"]
