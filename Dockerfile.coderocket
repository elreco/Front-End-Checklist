FROM node:24.15.0-bookworm-slim AS build
ARG NEXT_PUBLIC_SITE_URL=__CODEROCKET_SITE_URL__
ARG NEXT_PUBLIC_SUPABASE_URL=__CODEROCKET_SUPABASE_URL__
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=__CODEROCKET_SUPABASE_PUBLISHABLE_KEY__
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ARG NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=__CODEROCKET_ANALYTICS_ID__
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=$NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION
ENV NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=$NEXT_PUBLIC_GOOGLE_ANALYTICS_ID
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @coderocket/cloud build
RUN cp -R apps/cloud/public apps/cloud/.next/standalone/apps/cloud/ \
  && mkdir -p apps/cloud/.next/standalone/apps/cloud/.next \
  && cp -R apps/cloud/.next/static apps/cloud/.next/standalone/apps/cloud/.next/

FROM node:24.15.0-bookworm-slim AS runtime
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && pnpm --version
WORKDIR /app
COPY --from=build /app /app
EXPOSE 3000
CMD ["sh", "-lc", "node scripts/setup/prepare-coderocket-runtime-env.mjs && node apps/cloud/.next/standalone/apps/cloud/server.js"]
