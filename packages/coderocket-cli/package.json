{
  "name": "@coderocketapp/cli",
  "version": "0.2.0",
  "private": false,
  "description": "Run CodeRocket website quality gates from CI and GitHub Actions",
  "homepage": "https://www.coderocket.app/docs/cli",
  "bugs": {
    "url": "https://github.com/elreco/Front-End-Checklist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elreco/Front-End-Checklist.git",
    "directory": "packages/coderocket-cli"
  },
  "type": "module",
  "bin": {
    "coderocket": "./dist/index.js"
  },
  "files": [
    "dist",
    "rules",
    "README.md"
  ],
  "scripts": {
    "audit:local": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "lint": "biome check .",
    "prepack": "pnpm build",
    "test": "node --import tsx --test test/*.test.ts",
    "test:ci": "node --import tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@coderocket/core": "workspace:*",
    "@repo/config-typescript": "workspace:^",
    "@types/node": "catalog:",
    "esbuild": "^0.25.12",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
