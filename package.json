{
  "name": "coderocket-elreco",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "configs/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:coderocket": "turbo dev --filter=@coderocket/cloud --filter=@coderocket/worker",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "test:coverage": "turbo test:coverage",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "prepare": "node scripts/setup/install-lefthook.mjs",
    "lefthook:run": "lefthook run pre-commit",
    "ci:check": "pnpm run lint && pnpm run typecheck && pnpm run test:ci && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "lefthook": "^2.1.9",
    "tsx": "catalog:",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
